{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_hooks.py primer",
            "timeout": 10,
            "statusMessage": "Reading docs/.state.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/session_hooks.py tree",
            "timeout": 15,
            "statusMessage": "Checking the tree"
          }
        ]
      }
    ]
  }
}
