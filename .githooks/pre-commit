#!/bin/sh
# Rebuild the generated docs from the staged tree and stage them, so the map of
# where things live and the shelves of what is settled and what the words mean
# each arrive in the same commit as the move, decision, or coinage it describes.
#
# Set SIEVE_SKIP_SCAFFOLD=1 to commit without them.
set -e

if [ "$SIEVE_SKIP_SCAFFOLD" = "1" ]; then
	exit 0
fi

root=$(git rev-parse --show-toplevel)

# The vocab convention, checked before the index is rebuilt from it: a gloss
# that is over its cap or a citation that no longer resolves is a failed
# commit, because the alternative is an entry that quietly stops being true
# while only the code moved.
uv run --quiet python -m checks.vocab

uv run --quiet python "$root/scripts/doc_index.py" --quiet
git add -- "$root/docs/SCAFFOLD.md" "$root/docs/ADR.md" \
	"$root/docs/VOCAB.md" "$root/docs/solutions/INDEX.md"
