# Machine-checked layer boundaries — the forbidden edge set of VISION.md's
# component table, made checkable.
#
# A violation here is a product regression, not a style problem: the moment
# `pipeline/` imports Qt, headless CLI and cluster parity stops being real.
# These bind before the packages have contents (adapted from v2's
# `.importlinter`, whose four bespoke contracts existed because the plain
# layers contract could not say what mattered) so that no boundary is ever
# widened to accommodate code already written against it.

[importlinter]
root_package = sieve
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
# `sieve.mutual` sits below the decode row and above `core` because that is
# where a reading of the machine has to live to be shared: `decode/` and the
# front ends all size themselves against it, and a copy of the reading in each
# is two answers to "how much of this machine do I have". There is no `compat`
# layer — v2 projects do not import (adr/v2-does-not-import.md) — and no
# `backend` or `detect`, both dissolved (adr/no-kernel-apparatus.md,
# adr/detector-is-a-node.md).
layers =
    sieve.gui | sieve.cli
    sieve.session
    sieve.bench
    sieve.pipeline
    sieve.tools
    sieve.decode | sieve.storage
    sieve.mutual
    sieve.core

[importlinter:contract:core-purity]
name = core and mutual import no toolkit, no codec, no processes
type = forbidden
# `mutual` is named here for the reason it is a layer of its own rather than a
# corner of `core`: it reads the machine, so it holds the one import — `psutil`
# — that a pure package may not, and the price of that permission is being held
# to the same five refusals `core` is.
source_modules =
    sieve.core
    sieve.mutual
forbidden_modules =
    PySide6
    cv2
    zarr
    subprocess
    multiprocessing

[importlinter:contract:headless]
name = the CLI, pipeline, bench, decode, storage, and tools run without a GUI toolkit
type = forbidden
source_modules =
    # The CLI is the front end whose whole point is being usable where Qt is
    # not installed — a cluster node, a container, a login shell. It sits at the
    # same layer as `sieve.gui` and so the layers contract cannot say this.
    sieve.cli
    # `session` is Qt-free by decision, not by layer position: it sits directly
    # under `gui`, so the layers contract permits the import this line forbids —
    # undo/redo as whole pipeline values is the shape that keeps history out of
    # the widgets (VISION.md's `session` row, which is where that rule lives), and a
    # Qt import here would be view state moving in with the document.
    sieve.session
    sieve.pipeline
    sieve.bench
    sieve.decode
    sieve.storage
    sieve.tools
forbidden_modules =
    PySide6

[importlinter:contract:gui-computes-nothing]
name = the GUI renders values and emits intents; it computes nothing
type = forbidden
# The layers contract governs direction of dependency and so could never say
# this: `gui` sits above `tools` and `core`, which makes importing a tool's
# `run` into a widget legal under every other contract here while being
# exactly the second implementation path that adr/one-execution-path.md
# forbids.
#
# Direct imports only. `gui -> pipeline -> tools` is the supported path — the
# one execution path, reached from above. What this forbids is `gui/`
# *holding* a computation, which is only ever a direct import.
#
# Importing `sieve.tools` is also how a renderer learns tool identity, so this
# line doubles as adr/gui-knows-kinds-not-tools.md's gate: the generator reads
# spec data out of the registry in `core`, and a widget that needs the tool
# module itself is a `tool_id` branch that has not been written yet.
# `sieve.core.ops` does not exist yet (adr/ops-admission-is-two-tools.md) and
# is named anyway, to refuse the sideways move the day it does.
allow_indirect_imports = True
source_modules =
    sieve.gui
forbidden_modules =
    sieve.tools
    sieve.core.ops
# No exceptions, and the `error` alerting is what keeps it that way: the list
# is empty from commit one because there is no v2 GUI code to grandfather, so
# any entry added later is a reviewed widening rather than a debt inherited.
unmatched_ignore_imports_alerting = error

[importlinter:contract:session-computes-nothing]
name = the session holds pipeline values and asks for runs; it computes nothing
type = forbidden
# The third instance of the shape `gui-computes-nothing` was minted for, and it
# sits between the two that already have one: `session` is above `tools` and
# `core`, so a session module importing a tool's `run` points downward and is
# legal under every other contract here. `headless` names `sieve.session` too,
# but only against `PySide6`, so the row's "computing anything" was unenforced
# while the package was empty
# (findings/2026.08.08-vision-never-column-has-two-import-shaped-lines-no-contract-checks.md).
#
# Its own contract rather than a second source under `gui-computes-nothing`,
# which forbids the same two modules: the sets coincide today and the reasons
# do not. `gui`'s line doubles as adr/gui-knows-kinds-not-tools.md's gate, which
# says nothing about a document layer, and one contract over both rows would
# need a name that describes neither.
#
# Direct imports only. `session -> pipeline -> tools` is the supported path —
# holding what `gui` renders and asking `pipeline` for the rest is the whole of
# what this layer does. What this forbids is `session/` *holding* a
# computation, which is only ever a direct import.
allow_indirect_imports = True
source_modules =
    sieve.session
forbidden_modules =
    sieve.tools
    sieve.core.ops
unmatched_ignore_imports_alerting = error

[importlinter:contract:pipeline-computes-nothing]
name = the pipeline runs tools; it holds no array math of its own
type = forbidden
# `gui-computes-nothing` one row down, and for the same reason the row above it
# needed one: `core` sits below `pipeline`, so `pipeline -> core.ops` points
# downward and every other contract here allows it. Reaching a tool's array
# math from the executor is the second execution path
# (adr/one-execution-path.md), taken by the layer that owns the first.
#
# Direct imports only. `pipeline -> tools -> ops` is the supported path, and
# `sieve.tools` is absent from the list below because running a tool is what
# the executor is for. What this forbids is `pipeline/` *holding* a
# computation, which is only ever a direct import.
#
# `sieve.core.ops` does not exist yet (adr/ops-admission-is-two-tools.md), so
# this line is inert until it does
# (findings/2026.08.06-a-forbidden-module-that-does-not-exist-is-inert.md) and
# `lint-imports` cannot go red for it here. The red owed for it is paid in
# `tests/unit/test_import_contracts.py`, against a copy of the tree where
# `ops/` exists.
allow_indirect_imports = True
source_modules =
    sieve.pipeline
forbidden_modules =
    sieve.core.ops
unmatched_ignore_imports_alerting = error

[importlinter:contract:decode-knows-no-schema]
name = decode knows frames and time; it does not know what a schema is
type = forbidden
# The other half of the same walk. `decode` must never know "what a tool or a
# schema is": the tool half is free, since `tools` sits above `decode` and the
# layers contract refuses it, and the schema half points downward into `core`
# and so needs saying. What the row grants `decode` of `core` is the
# dimensioned types, which is what it imports.
#
# No `allow_indirect_imports` here, unlike the three contracts above: each of
# those keeps a supported route open — the layer reaches the forbidden module
# through the one below it — and `decode` has no route to a schema at all. A
# chain that arrived at one would be the same knowledge, so the strict form is
# the one that matches the row.
source_modules =
    sieve.decode
forbidden_modules =
    sieve.core.pipeline_model
unmatched_ignore_imports_alerting = error

[importlinter:contract:opencv-containment]
name = OpenCV stays out of core, bench, the pipeline, the session, and the front ends
type = forbidden
# Direct imports only: reaching a decoded frame *through* `sieve.decode` is
# the supported path. What this forbids is a second module learning to drive
# VideoCapture itself, which is how decoder identity stops being one string
# and cache keys stop meaning anything.
#
# `sieve.tools` is deliberately absent from the sources below — it is the one
# place outside `decode` where cv2 is legal. A tool calling
# `cv2.calcOpticalFlowFarneback` never touches a container, a seek, or decoder
# identity, so the rationale above does not reach it. What keeps such a tool
# honest is its spec: a declared version that enters the cache key.
allow_indirect_imports = True
source_modules =
    sieve.core
    sieve.bench
    sieve.gui
    # Both front ends, for one reason: reaching a frame goes through
    # `sieve.decode`, so a `cv2` import here would be a command that had started
    # driving `VideoCapture` on its own — a second seek strategy, and a second
    # decoder identity that no cache key would know about.
    sieve.cli
    # The document layer, for that same reason and harder: what `session` holds
    # is the pipeline value the front ends render, so a `VideoCapture` opened
    # here would be a second decoder identity inside the thing whose identity
    # the cache key is computed from. `headless` names the package too, but only
    # against `PySide6`, so this line is the teeth on the cv2-shaped half of
    # VISION's session row, which never computes anything.
    sieve.session
    # The executor, where that rationale is heaviest rather than merely
    # applicable: this is the layer that *computes* the cache keys, so a
    # `VideoCapture` opened here would be a second decoder identity inside the
    # thing that decides what a cached result answers for. The row said Qt and
    # `ops/` and nothing codec-shaped until this commit widened it, which is why
    # no walk of VISION's `Never` column ever reached the gap
    # (findings/2026.08.08-vision-never-column-has-two-import-shaped-lines-no-contract-checks.md,
    # dated section).
    sieve.pipeline
forbidden_modules =
    cv2
