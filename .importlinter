# Layer dependency contract for SIEVE, encoding ARCHITECTURE.md section 3.
#
# These are not style rules. The layer model is what makes CLI and HPC parity
# real rather than aspirational: a Qt import reaching pipeline/ means a
# headless run can no longer drive the same executor the GUI drives, and that
# is the loss of a product guarantee. A violation here is a design question,
# not a lint fix.
#
# The contract is written for layers that are still mostly empty, so the rule
# is in place before the first import that could break it. Run it with
# `nox -s layers`.

[importlinter]
root_package = sieve
include_external_packages = True

[importlinter:contract:layer-order]
name = Dependencies run one way through the layer model
type = layers
layers =
    sieve.gui | sieve.cli | sieve.review
    sieve.bench
    sieve.workers
    sieve.pipeline
    sieve.backends | sieve.io
    sieve.core

[importlinter:contract:qt-free-below-gui]
name = Only gui/ imports a GUI toolkit
# bench/ is included deliberately. ARCHITECTURE.md section 14 originally placed
# a QObject metric bus here; keeping it Qt-free is what lets the CLI and a
# headless benchmark run import bench/ at all. The QObject adapter lives in
# gui/ and subscribes to a plain-callback bus.
type = forbidden
source_modules =
    sieve.core
    sieve.backends
    sieve.io
    sieve.pipeline
    sieve.workers
    sieve.bench
forbidden_modules =
    PySide6
    PyQt6
    qtpy
    napari
    pyqtgraph

[importlinter:contract:gui-reaches-workers-through-pipeline]
name = gui/ never talks to workers/ directly
# The GUI process does not own worker lifecycle, generation tracking, or
# cancellation. Routing through pipeline/ is what keeps a stale result from
# reaching a widget after the parameters that produced it changed.
type = forbidden
source_modules =
    sieve.gui
forbidden_modules =
    sieve.workers

[importlinter:contract:core-stays-pure]
name = core/ has no storage, no processes, no I/O
# core/ is the layer that has to be trivially testable and trivially portable
# between the CPU and GPU backends. Reaching a store or spawning a process from
# a filter would make it neither.
type = forbidden
source_modules =
    sieve.core
forbidden_modules =
    zarr
    subprocess
    multiprocessing
    duckdb
    pyarrow
    cv2
