# Machine-checked layer boundaries (ARCHITECTURE.md).
#
# A violation here is a product regression, not a style problem: the moment
# `pipeline/` imports Qt, headless CLI and HPC parity stops being real.
# Parenthesised layers are optional — declared before they exist so the
# contract governs them from their first commit rather than being widened to
# accommodate them afterwards.

[importlinter]
root_package = sieve
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    sieve.gui | sieve.cli
    sieve.bench
    sieve.pipeline | (sieve.workers)
    sieve.filters
    sieve.decode | sieve.storage | sieve.backend | sieve.detect
    (sieve.mutual)
    sieve.core

[importlinter:contract:core-purity]
name = core and mutual import no toolkit, no codec, no processes
type = forbidden
source_modules =
    sieve.core
    sieve.mutual
forbidden_modules =
    PySide6
    cv2
    zarr
    subprocess
    multiprocessing

[importlinter:contract:headless]
name = the CLI, pipeline, bench, decode, filters, and backend run without a GUI toolkit
type = forbidden
source_modules =
    # The CLI is the front end whose whole point is being usable where Qt is
    # not installed — a cluster node, a container, a login shell. It sits at the
    # same layer as `sieve.gui` and so the layers contract cannot say this.
    sieve.cli
    sieve.pipeline
    sieve.bench
    sieve.decode
    sieve.storage
    sieve.filters
    sieve.backend
    # The whole point of the package: `DetectorSettings` is a saved field, so
    # the composition that turns it into intervals must be reachable from a
    # cluster node. It lived under `sieve.gui` and this line is what stops it
    # going back (docs/todo/headless-detection.md).
    sieve.detect
forbidden_modules =
    PySide6

[importlinter:contract:gui-computes-nothing]
name = the GUI renders values and emits intents; it computes nothing
type = forbidden
# REWORK.md R1's gate. The layers contract governs direction of dependency and
# so could never say this: `gui` sits above `core`, which makes importing
# `morlet_power` into a widget legal under all four contracts below while being
# exactly the second implementation rule 1 forbids.
#
# Direct imports only, for `opencv-containment`'s reason and a sharper version
# of it: once detection is a filter, `gui -> pipeline -> filters ->
# core.ops.wavelet` is the supported path — the one execution path reached from
# above. What this forbids is `gui/` *holding* a computation, which is only
# ever a direct import.
#
# `sieve.core.ops.detection` carries no exceptions: nothing in `gui/` imports it
# today, and the line exists to refuse the sideways move — deleting a wavelet
# import by reaching for `count_band_to_counts` instead.
allow_indirect_imports = True
source_modules =
    sieve.gui
forbidden_modules =
    sieve.core.ops.wavelet
    sieve.core.ops.detection
    sieve.detect
# The exception list is the work list (REWORK.md). The `error` alerting below
# is what makes it shrink-only: an entry whose import is gone fails the
# contract, so removing the code and removing its exception are one edit, and
# adding an entry is a reviewed widening of the rework itself.
unmatched_ignore_imports_alerting = error
ignore_imports =
    sieve.gui.chain_model -> sieve.core.ops.wavelet
    sieve.gui.filter_tab -> sieve.core.ops.wavelet
    sieve.gui.scalogram_plot -> sieve.core.ops.wavelet

[importlinter:contract:transport-is-handed-its-work]
name = the transport is handed a request; it never reaches for the project
type = forbidden
# `sieve.gui.transport` is how a frame is asked for and how it arrives. Its
# whole input is a request — a frame, a consumer, an intent — so a second tab
# can drive it without either tab learning about the other. That property is
# invisible to the layers contract, which governs packages and sees `gui` as
# one unit; this is the sentence made checkable.
#
# The direction is the point. Widgets above may reach down into the transport;
# a reach back up is the defect. `sieve.gui.timeline` is on the list for the
# same reason and a sharper one: `player` and `timeline_bar` shared a module
# until this package was drawn, and the two halves of it went opposite ways
# (`transport/pacing.py`, `timeline/geometry.py`) precisely so the packages
# would not import each other. Without this line the cycle reforms the first
# time a paint rule looks convenient from below.
#
# Not on the list, deliberately: `preferences`. The transport reads persisted
# user settings and that is a downward read like any other.
allow_indirect_imports = True
source_modules =
    sieve.gui.transport
forbidden_modules =
    sieve.gui.document
    sieve.gui.filter_tab
    sieve.gui.main_window
    sieve.gui.replicate_tab
    sieve.gui.timeline

[importlinter:contract:opencv-containment]
name = OpenCV stays out of core, mutual, bench, and front ends
type = forbidden
# Direct imports only: reaching a decoded frame *through* `sieve.decode` is
# the supported path. What this forbids is a second module learning to drive
# VideoCapture itself, which is how decoder identity stops being one string
# and cache keys stop meaning anything.
#
# `sieve.filters` is deliberately absent from the sources below. A filter
# kernel calling `cv2.calcOpticalFlowFarneback` never touches a container, a
# seek, or decoder identity, so the rationale above does not reach it. What
# keeps such a kernel honest is the spec it hangs off: a declared version that
# enters the cache key, and `backend_agnostic = False` so the backend identity
# does too.
allow_indirect_imports = True
source_modules =
    sieve.core
    sieve.mutual
    sieve.bench
    sieve.gui
    # Both front ends, for one reason: reaching a frame goes through
    # `sieve.decode`, so a `cv2` import here would be a command that had started
    # driving `VideoCapture` on its own — a second seek strategy, and a second
    # decoder identity that no cache key would know about.
    sieve.cli
forbidden_modules =
    cv2
