[importlinter]
root_package = sieve
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    sieve.gui | sieve.cli
    sieve.bench
    sieve.pipeline | (sieve.workers)
    sieve.filters
    sieve.decode | sieve.storage | sieve.backend | sieve.detect
    sieve.core

[importlinter:contract:core-purity]
name = Core stays independent of toolkits, codecs, and processes
type = forbidden
source_modules =
    sieve.core
forbidden_modules =
    PySide6
    cv2
    zarr
    subprocess
    multiprocessing

[importlinter:contract:headless]
name = Headless packages do not import Qt
type = forbidden
source_modules =
    sieve.cli
    sieve.pipeline
    sieve.bench
    sieve.decode
    sieve.storage
    sieve.filters
    sieve.backend
    sieve.detect
forbidden_modules =
    PySide6

[importlinter:contract:gui-computes-nothing]
name = The GUI does not directly own scientific computation
type = forbidden
allow_indirect_imports = True
source_modules =
    sieve.gui
forbidden_modules =
    sieve.core.wavelet
    sieve.core.detection
    sieve.detect
unmatched_ignore_imports_alerting = error
ignore_imports =
    sieve.gui.chain_model -> sieve.core.wavelet
    sieve.gui.chain_model -> sieve.detect
    sieve.gui.detector_worker -> sieve.core.wavelet
    sieve.gui.detector_worker -> sieve.detect
    sieve.gui.filter_tab -> sieve.core.wavelet
    sieve.gui.filter_tab -> sieve.detect
    sieve.gui.scalogram_plot -> sieve.core.wavelet

[importlinter:contract:opencv-containment]
name = OpenCV stays out of core, bench, GUI, and CLI
type = forbidden
allow_indirect_imports = True
source_modules =
    sieve.core
    sieve.bench
    sieve.gui
    sieve.cli
forbidden_modules =
    cv2
